msgid "Win11 Frosted Panel"
msgstr "Win11 Painel Fosco"

msgid "Appearance"
msgstr "Aparência"

msgid "Advanced & Behavior"
msgstr "Avançado e Comportamento"

msgid "Language / Idioma"
msgstr "Idioma / Language"

msgid "Windows 11 Theme & Opacity"
msgstr "Tema Windows 11 e Opacidade"

